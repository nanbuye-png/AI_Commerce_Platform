# Copy to .env in this directory. The real file is ignored by Git.
# PostgreSQL 数据库连接
DB_URL=jdbc:postgresql://localhost:5432/ai_commerce_platform
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password

# 三端 JWT 密钥（生产必须使用至少 32 位随机字符，且三端不同）
JWT_CUSTOMER_WEB_SECRET=replace-with-at-least-32-random-characters-customer
JWT_MERCHANT_WEB_SECRET=replace-with-at-least-32-random-characters-merchant
JWT_ADMIN_WEB_SECRET=replace-with-at-least-32-random-characters-admin

# AI 服务
AI_SERVICE_BASE_URL=http://localhost:8000
# 必须与 ai-service/.env 中的 AI_INTERNAL_API_TOKEN 完全一致
AI_INTERNAL_API_TOKEN=replace-with-a-shared-high-entropy-internal-token

# 初始管理员账号（首次启动时自动创建，仅当库中尚无任何 ADMIN 时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com
# 是否允许 ADMIN 角色自助注册（生产建议保持 false）
ALLOW_ADMIN_SELF_REGISTER=false

# CORS 允许的前端来源（默认已包含 5173/5174/5175 三个本地开发端口）
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175