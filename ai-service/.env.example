# Copy to .env in this directory. The real file is ignored by Git.
# Must exactly match backend/commerce-platform/.env.
AI_INTERNAL_API_TOKEN=replace-with-a-shared-high-entropy-internal-token
COMMERCE_CORE_BASE_URL=http://localhost:8080
COMMERCE_CORE_TIMEOUT_SECONDS=5

# The deterministic local provider does not call an external LLM API.
# AI_LLM_PROVIDER=mock

# DeepSeek (OpenAI-compatible) 配置示例：
# 1) 将 provider 设置为 openai-compatible
# 2) base_url 使用 https://api.deepseek.com/v1
# 3) 填入你的 DeepSeek API Key（sk-...）
# 4) 模型可选用 deepseek-chat 或 deepseek-reasoner
AI_LLM_PROVIDER=openai-compatible
AI_LLM_BASE_URL=https://api.deepseek.com/v1
AI_LLM_API_KEY=replace-with-your-deepseek-api-key
AI_DEFAULT_MODEL=deepseek-chat

# 可选调优
# AI_LLM_TIMEOUT_SECONDS=60
# AI_LLM_TEMPERATURE=0.2
# AI_LLM_MAX_TOKENS=1024